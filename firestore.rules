rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for clean security verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny-all for any unmapped collections at root
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Tasks collection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Habits & recurring task templates
      match /taskTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      // Workspace categories
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // Projects
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }

      // Email & Push reminder settings
      match /reminderSettings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Custom habit reminders (Gym, Running, Water intake, etc.)
      match /customReminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }

      // Web Push FCM registration device tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // In-app notification center history
      match /notificationHistory/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // Carry forward decisions & daily generation runs
      match /carryForwardDecisions/{decisionId} {
        allow read, write: if isOwner(userId);
      }

      match /generationRuns/{runId} {
        allow read, write: if isOwner(userId);
      }

      // Reminder delivery audit events & idempotency records
      // User can read; server handles privileged execution writes
      match /reminderEvents/{eventId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Catch-all fallback for any additional subcollections in the user's private data tree
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
